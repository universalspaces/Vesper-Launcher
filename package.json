{
  "name": "vesper-launcher",
  "version": "0.3.2",
  "description": "Vesper launcher for Minecraft Bedrock on Windows",
  "main": "src/main.js",
  "author": "universalspaces",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "pack:win": "electron-builder --win dir",
    "dist:win": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "1.3.4",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.vesper.launcher",
    "productName": "Vesper Launcher",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/vesper_logo_compact.png",
      "assets/vesper_title_compact.png",
      "assets/panorama.png",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "assets/Vesper-UI-V1.4.1.mcpack",
        "to": "Vesper-UI-V1.4.1.mcpack"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "publish": [
        {
          "provider": "github",
          "owner": "universalspaces",
          "repo": "Vesper-Launcher",
          "releaseType": "release"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Vesper Launcher"
    },
    "artifactName": "Vesper-Launcher-Setup-${version}-${arch}.${ext}"
  }
}
